# Copy this file to .env and fill in real values.
DATABASE_URL=postgres://username:password@localhost:5432/arthuriq
PORT=3001

# Needed for scripts/sendWeeklyReports.js — get RESEND_API_KEY from your
# Resend dashboard. REPORT_FROM_EMAIL must be an address on a domain
# you've verified with Resend (e.g. reports@arthuriq.com).
RESEND_API_KEY=
REPORT_FROM_EMAIL=
